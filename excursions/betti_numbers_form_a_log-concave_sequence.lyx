\begin_layout Title
The Betti Numbers 
\begin_inset Formula $\dim A^{i}(\overline{\mathcal{L}}_{n}^{r})$
\end_inset

 Form a Log-Concave Sequence
\end_layout

\begin_layout Author
Claude Opus 5 and Zack M.
 Davis
